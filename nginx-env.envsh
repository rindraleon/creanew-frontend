#!/bin/sh
# Chargé dans le shell de l'entrypoint nginx avant envsubst.
API_UPSTREAM_ORIGIN="${API_UPSTREAM_ORIGIN:-http://backend:3000}"
PORT="${PORT:-80}"
DNS_RESOLVER="$(awk '$1 == "nameserver" && $2 ~ /^[0-9.]+$/ { print $2; exit }' /etc/resolv.conf)"

# Valeurs contrôlées avant substitution dans la configuration nginx :
# pas de chemin, identifiant, espaces ou directives injectables.
if ! printf '%s' "$API_UPSTREAM_ORIGIN" | grep -Eq '^https?://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?$'; then
  echo >&2 'API_UPSTREAM_ORIGIN doit être une origine http(s) valide sans chemin ni identifiants.'
  exit 1
fi
case "$PORT" in
  ''|*[!0-9]*) echo >&2 'PORT doit être un entier compris entre 1 et 65535.'; exit 1 ;;
esac
if [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
  echo >&2 'PORT doit être compris entre 1 et 65535.'
  exit 1
fi
if ! printf '%s' "$DNS_RESOLVER" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
  echo >&2 'Un résolveur DNS IPv4 est requis dans /etc/resolv.conf.'
  exit 1
fi
export API_UPSTREAM_ORIGIN PORT DNS_RESOLVER
